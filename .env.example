# WeatherLink API Credentials - GDC Station
WEATHERLINK_API_KEY=your_api_key_v2_here
WEATHERLINK_API_SECRET=your_api_secret_v2_here
WEATHERLINK_API_TOKEN_V1=your_api_token_v1_here

# Station ID - run: python main.py --list-stations
WEATHERLINK_STATION_ID=

# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL=300

# Optional: InfluxDB for Grafana integration (future)
INFLUXDB_ENABLED=false
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=GDC
INFLUXDB_BUCKET=weather

# Alerting — webhook URL (Slack, Teams, Discord, etc.) — leave blank to log only
ALERT_WEBHOOK_URL=
ALERT_STALE_MINUTES=15

# Prometheus metrics port (default 9001, scrape at http://host:9001/metrics)
METRICS_PORT=9001
