# GDC Weather — configuration. Copy to .env (never commit .env).
# Only the WEATHERLINK_* lines must be filled by hand; setup.sh / setup.ps1 generate the rest.

# ── WeatherLink v2 API (weatherlink.com → Account → API Key v2) ──────────────────
WEATHERLINK_API_KEY=
WEATHERLINK_API_SECRET=
# Station to poll. Find it with:  docker compose run --rm gdc-weather python main.py --list-stations
WEATHERLINK_STATION_ID=
WEATHERLINK_STATION_UUID=
# Place name, added as the location="…" label on every Prometheus metric.
STATION_LOCATION=Mirbat

# ── Only for old WeatherLinkIP / USB / serial loggers (v1 API). Leave blank otherwise. ──
WEATHERLINK_API_TOKEN_V1=
WEATHERLINK_DID=
WEATHERLINK_USERNAME=
WEATHERLINK_PASSWORD=

# ── Poller ────────────────────────────────────────────────────────────────────────
# Seconds between live polls. 60 = one reading per minute (the live feed refreshes about once a minute).
POLL_INTERVAL=60
# Optional webhook (Slack, Teams, Discord…) for the poller's own alerts; blank = log only.
ALERT_WEBHOOK_URL=
ALERT_STALE_MINUTES=15
METRICS_PORT=9001

# ── InfluxDB ──────────────────────────────────────────────────────────────────────
INFLUXDB_ENABLED=true
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=GDC
INFLUXDB_BUCKET=weather

# ── Grafana Cloud copy of the dashboard (optional, see cloud/README.md) ──────────────
GRAFANA_CLOUD_URL=
# Service-account token (Editor/Admin on the dashboard folder). Only needed to run cloud/upload.py.
GRAFANA_CLOUD_TOKEN=

# ── Local secrets — generated by setup.sh / setup.ps1 on each computer. Leave blank. ──
# Grafana login password (user: admin)
GF_ADMIN_PASSWORD=
# InfluxDB admin login + all-access token (maintenance only)
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ADMIN_TOKEN=
# Write-only token for the weather bucket (used by the poller)
INFLUXDB_TOKEN=
# Read-only token for the weather bucket (used by Grafana)
INFLUXDB_GRAFANA_TOKEN=
