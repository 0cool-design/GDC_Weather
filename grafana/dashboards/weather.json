        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh", "decimals": 1,
          "color": {"mode": "fixed", "fixedColor": "#f59e0b"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "#f59e0b", "value": null}]}
        }
      },
      "targets": [{"datasource": "InfluxDB", "refId": "A",
        "query": "from(bucket:\"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r)=>r._measurement==\"weather\" and r.sensor_type==\"37\" and r._field==\"wind_speed_hi_last_10_min\") |> map(fn:(r)=>({r with _value:r._value*1.60934})) |> max() |> yield(name:\"Max Gust\")"
      }]
    },

