    {
      "id": 600, "type": "row",
      "title": "📅 Temperature Heatmap",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 42}
    },

    {
      "id": 60, "type": "heatmap",
      "title": "Temperature Distribution Over Time (°C) — set time range to 30+ days for best view",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 43},
      "options": {
        "calculate": true,
        "calculation": {
          "xBuckets": {"mode": "count", "value": "60"},
          "yBuckets": {"mode": "count", "value": "20"}
        },
        "color": {
          "scheme": "RdYlBu",
          "mode": "scheme",
          "reverse": true,
          "steps": 64
        },
        "yAxis": {"unit": "celsius", "decimals": 0, "min": 10, "max": 50},
        "tooltip": {"show": true},
        "legend": {"show": true},
        "cellGap": 1,
        "filterValues": {"le": 1e-9}
      },
      "fieldConfig": {
        "defaults": {"unit": "celsius"}
      },
      "targets": [
        {
          "datasource": "InfluxDB", "refId": "A",
