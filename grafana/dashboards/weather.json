    {
      "id": 41, "type": "timeseries",
      "title": "Rain Rate & Daily Total",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 25},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["max"]},
        "tooltip": {"mode": "multi"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthmm", "decimals": 1,
          "custom": {"lineWidth": 1.5, "fillOpacity": 20, "spanNulls": false, "drawStyle": "bars"},
          "color": {"mode": "fixed", "fixedColor": "#60a5fa"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Daily Total mm"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "#2563eb", "mode": "fixed"}},
              {"id": "custom.drawStyle", "value": "line"},
              {"id": "custom.fillOpacity", "value": 10},
              {"id": "custom.lineWidth", "value": 2}
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": "InfluxDB", "refId": "A",
          "query": "from(bucket:\"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r)=>r._measurement==\"weather\" and r.sensor_type==\"37\" and r._field==\"rain_rate_last\") |> map(fn:(r)=>({r with _value:r._value*25.4})) |> aggregateWindow(every: v.windowPeriod, fn:max, createEmpty:false) |> yield(name:\"Rain Rate mm/hr\")"
        },
        {
