{
  "id": null,
  "uid": "gdc-weather",
  "title": "GDC Weather Station",
  "description": "GDC Weather Station · Muscat, Oman · 23°36′N 58°35′E · Alt 10 m",
  "tags": ["weather", "gdc", "muscat", "oman", "iot"],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {"from": "now-400d", "to": "now"},
  "timepicker": {},
  "panels": [

    {
      "id": 100, "type": "row",
      "title": "⛅ Current Conditions",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },

    {
      "id": 1, "type": "stat",
      "title": "Station",
      "gridPos": {"h": 3, "w": 3, "x": 0, "y": 1},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background", "textMode": "auto", "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {
              "0": {"text": "OFFLINE", "color": "red"},
              "1": {"text": "ONLINE", "color": "green"}
            }}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]},
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [{"datasource": "Prometheus", "expr": "weather_up", "instant": true, "refId": "A"}]
    },

    {
      "id": 2, "type": "stat",
      "title": "Temperature",
      "gridPos": {"h": 3, "w": 3, "x": 3, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "celsius", "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "blue", "value": null}, {"color": "green", "value": 20},
            {"color": "yellow", "value": 30}, {"color": "orange", "value": 37},
            {"color": "red", "value": 42}
          ]},
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [{"datasource": "Prometheus", "expr": "(weather_temperature_f - 32) * 5/9", "instant": true, "legendFormat": "°C", "refId": "A"}]
    },

    {
      "id": 3, "type": "stat",
      "title": "Humidity",
      "gridPos": {"h": 3, "w": 3, "x": 6, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "yellow", "value": null}, {"color": "green", "value": 30}, {"color": "blue", "value": 70}
          ]},
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [{"datasource": "Prometheus", "expr": "weather_humidity_pct", "instant": true, "legendFormat": "%", "refId": "A"}]
    },

    {
      "id": 4, "type": "stat",
      "title": "Dew Point",
      "gridPos": {"h": 3, "w": 3, "x": 9, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "celsius", "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "blue", "value": null}, {"color": "green", "value": 10},
            {"color": "yellow", "value": 18}, {"color": "orange", "value": 24}, {"color": "red", "value": 28}
          ]},
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [{"datasource": "Prometheus", "expr": "(weather_dew_point_f - 32) * 5/9", "instant": true, "legendFormat": "°C", "refId": "A"}]
    },

    {
      "id": 5, "type": "stat",
      "title": "Wind Speed",
      "gridPos": {"h": 3, "w": 3, "x": 12, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh", "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null}, {"color": "yellow", "value": 20},
            {"color": "orange", "value": 40}, {"color": "red", "value": 60}
          ]},
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [{"datasource": "Prometheus", "expr": "weather_wind_speed_mph * 1.60934", "instant": true, "legendFormat": "km/h", "refId": "A"}]
    },

    {
      "id": 6, "type": "stat",
      "title": "Wind Gust 10 min",
      "gridPos": {"h": 3, "w": 3, "x": 15, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh", "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null}, {"color": "yellow", "value": 30},
            {"color": "orange", "value": 50}, {"color": "red", "value": 70}
          ]},
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [{"datasource": "Prometheus", "expr": "weather_wind_speed_hi_10min_mph * 1.60934", "instant": true, "legendFormat": "km/h", "refId": "A"}]
    },

    {
      "id": 7, "type": "stat",
      "title": "Pressure",
      "gridPos": {"h": 3, "w": 3, "x": 18, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehpa", "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "blue", "value": null}, {"color": "green", "value": 1000}, {"color": "blue", "value": 1030}
          ]},
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [{"datasource": "Prometheus", "expr": "weather_barometer_inhg * 33.8639", "instant": true, "legendFormat": "hPa", "refId": "A"}]
    },

    {
      "id": 8, "type": "stat",
      "title": "UV Index",
      "gridPos": {"h": 3, "w": 3, "x": 21, "y": 1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null}, {"color": "yellow", "value": 3},
            {"color": "orange", "value": 6}, {"color": "red", "value": 8}, {"color": "purple", "value": 11}
          ]},
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [{"datasource": "Prometheus", "expr": "weather_uv_index", "instant": true, "legendFormat": "UV", "refId": "A"}]
    },

    {
      "id": 200, "type": "row",
      "title": "🌡️ Temperature History",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4}
    },

    {
      "id": 20, "type": "timeseries",
      "title": "Temperature (°C) — Min / Avg / Max with Heat Stress Zones",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 5},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["min", "mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1.5, "fillOpacity": 8, "spanNulls": false,
            "thresholdsStyle": {"mode": "area"}
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "transparent", "value": null},
              {"color": "rgba(99,179,237,0.12)", "value": 25},
              {"color": "rgba(237,137,54,0.12)", "value": 30},
              {"color": "rgba(245,101,101,0.12)", "value": 35},
              {"color": "rgba(197,48,48,0.15)", "value": 40}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Max °C"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "#ef4444", "mode": "fixed"}},
              {"id": "custom.lineWidth", "value": 1},
              {"id": "custom.fillOpacity", "value": 0}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Min °C"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "#3b82f6", "mode": "fixed"}},
              {"id": "custom.lineWidth", "value": 1},
              {"id": "custom.fillOpacity", "value": 0}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Avg °C"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "#ff6730", "mode": "fixed"}},
              {"id": "custom.lineWidth", "value": 2.5}
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": "InfluxDB", "refId": "A",
          "query": "from(bucket:\"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r)=>r._measurement==\"weather\" and r.sensor_type==\"37\" and r._field==\"temp\") |> map(fn:(r)=>({r with _value:(r._value-32.0)*5.0/9.0})) |> aggregateWindow(every: v.windowPeriod, fn:mean, createEmpty:false) |> yield(name:\"Avg °C\")"
        },
        {
          "datasource": "InfluxDB", "refId": "B",
          "query": "from(bucket:\"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r)=>r._measurement==\"weather\" and r.sensor_type==\"37\" and r._field==\"temp\") |> map(fn:(r)=>({r with _value:(r._value-32.0)*5.0/9.0})) |> aggregateWindow(every: v.windowPeriod, fn:max, createEmpty:false) |> yield(name:\"Max °C\")"
        },
        {
          "datasource": "InfluxDB", "refId": "C",
          "query": "from(bucket:\"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r)=>r._measurement==\"weather\" and r.sensor_type==\"37\" and r._field==\"temp\") |> map(fn:(r)=>({r with _value:(r._value-32.0)*5.0/9.0})) |> aggregateWindow(every: v.windowPeriod, fn:min, createEmpty:false) |> yield(name:\"Min °C\")"
        }
      ]
    },

    {
      "id": 300, "type": "row",
      "title": "💨 Wind & Humidity",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15}
    },

    {
      "id": 30, "type": "timeseries",
      "title": "Wind Speed (km/h)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "custom": {"lineWidth": 2, "fillOpacity": 10, "spanNulls": false}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Avg km/h"},
            "properties": [{"id": "color", "value": {"fixedColor": "#34d399", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "10m avg km/h"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "#6ee7b7", "mode": "fixed"}},
              {"id": "custom.lineStyle", "value": {"dash": [6, 4], "fill": "dash"}},
              {"id": "custom.lineWidth", "value": 1.5}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Gust km/h"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "rgba(52,211,153,0.4)", "mode": "fixed"}},
              {"id": "custom.lineWidth", "value": 1},
              {"id": "custom.fillOpacity", "value": 4}
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": "InfluxDB", "refId": "A",
          "query": "from(bucket:\"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r)=>r._measurement==\"weather\" and r.sensor_type==\"37\" and r._field==\"wind_speed_last\") |> map(fn:(r)=>({r with _value:r._value*1.60934})) |> aggregateWindow(every: v.windowPeriod, fn:mean, createEmpty:false) |> yield(name:\"Avg km/h\")"
        },
        {
          "datasource": "InfluxDB", "refId": "B",
          "query": "from(bucket:\"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r)=>r._measurement==\"weather\" and r.sensor_type==\"37\" and r._field==\"wind_speed_avg_last_10_min\") |> map(fn:(r)=>({r with _value:r._value*1.60934})) |> aggregateWindow(every: v.windowPeriod, fn:mean, createEmpty:false) |> yield(name:\"10m avg km/h\")"
        },
        {
          "datasource": "InfluxDB", "refId": "C",
          "query": "from(bucket:\"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r)=>r._measurement==\"weather\" and r.sensor_type==\"37\" and r._field==\"wind_speed_hi_last_10_min\") |> map(fn:(r)=>({r with _value:r._value*1.60934})) |> aggregateWindow(every: v.windowPeriod, fn:max, createEmpty:false) |> yield(name:\"Gust km/h\")"
        }
      ]
    },

    {
      "id": 31, "type": "timeseries",
      "title": "Humidity & Dew Point",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "min", "max"]},
        "tooltip": {"mode": "multi"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "custom": {"lineWidth": 2, "fillOpacity": 10, "spanNulls": false}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Humidity %"},
            "properties": [{"id": "color", "value": {"fixedColor": "#22d3ee", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Dew Point °C"},
            "properties": [
              {"id": "unit", "value": "celsius"},
              {"id": "min", "value": null}, {"id": "max", "value": null},
              {"id": "color", "value": {"fixedColor": "#2dd4bf", "mode": "fixed"}},
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "custom.lineStyle", "value": {"dash": [6, 4], "fill": "dash"}}
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": "InfluxDB", "refId": "A",
          "query": "from(bucket:\"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r)=>r._measurement==\"weather\" and r.sensor_type==\"37\" and r._field==\"humidity\") |> aggregateWindow(every: v.windowPeriod, fn:mean, createEmpty:false) |> yield(name:\"Humidity %\")"
        },
        {
          "datasource": "InfluxDB", "refId": "B",
          "query": "from(bucket:\"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r)=>r._measurement==\"weather\" and r.sensor_type==\"37\" and r._field==\"dew_point\") |> map(fn:(r)=>({r with _value:(r._value-32.0)*5.0/9.0})) |> aggregateWindow(every: v.windowPeriod, fn:mean, createEmpty:false) |> yield(name:\"Dew Point °C\")"
        }
      ]
    },

    {
      "id": 400, "type": "row",
      "title": "🌧️ Pressure & Precipitation",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24}
    },

    {
      "id": 40, "type": "timeseries",
      "title": "Barometric Pressure (hPa)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 25},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "min", "max"]},
